<Name><![CDATA[puedeHacer]]></Name>
<X>1280</X><Y>280</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[idx]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[st]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[opId]]></Name>
<Type><![CDATA[String]]></Type>
</Parameter>
<Body><![CDATA[switch (st) {
case 0:
	return idx == 0;
case 1:
	return idx == 0 || idx == 1;
case 2:
	return idx == 1;
case 3:
	return idx == 1 || idx == 2;
case 4:
	return false;
case 5:
	return idx == 2;
}
return false;]]></Body>
</Function>
