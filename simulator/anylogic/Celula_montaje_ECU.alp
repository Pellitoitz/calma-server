<Id>1729000000171</Id>
<Name><![CDATA[op_carga]]></Name>
<X>1280</X><Y>-260</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[p]]></Name>
<Type><![CDATA[Pieza]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[st]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[// Carga de carcasa (loading)
Operario o = p.operario;
int m = estMaquina[st];
double espera = 0, caminar = 0;
if (o != null) {
	espera = pausaPendiente(o);
	caminar = caminar(o, st);
	recuperar(o);
}
double base = Math.max(0, dTriangular(8.0, 10.0, 16.0));
if (o != null) base = Math.max(0, 11.3333333333 + (base - 11.3333333333) * opConsistencia[o.idx]);
double f = factorProducto(p.producto, "carga", "loading");
if (o != null) {
	f *= 100.0 / ritmo(o.idx, "loading", "carga");
	f *= aprendizajeOp(o, "carga");
	f *= fatiga(o);
}
double trabajo = base * f;
double viaje = 0;
double interr = 0;
double averia = 0;
double total = espera + caminar + trabajo + viaje + interr + averia;
if (o != null) registrarTrabajo(o, "carga", total, espera);
return total;]]></Body>
</Function>
