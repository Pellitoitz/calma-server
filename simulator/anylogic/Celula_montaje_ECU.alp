<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000129</Id>
<Name><![CDATA[u01]]></Name>
<X>1100</X><Y>-300</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>

<Body><![CDATA[double x;
do { x = uniform(); } while (x <= 0 || x >= 1);
return x;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000130</Id>
<Name><![CDATA[nStd]]></Name>
<X>1100</X><Y>-280</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>

<Body><![CDATA[return Math.sqrt(-2 * Math.log(u01())) * Math.cos(2 * Math.PI * u01());]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000131</Id>
<Name><![CDATA[gammaStd]]></Name>
<X>1100</X><Y>-260</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[k]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[if (k < 1) return gammaStd(k + 1) * Math.pow(u01(), 1 / k);
double d = k - 1.0 / 3, c = 1 / Math.sqrt(9 * d);
while (true) {
	double x, v;
	do { x = nStd(); v = 1 + c * x; } while (v <= 0);
	v = v * v * v;
	double u = u01();
	if (u < 1 - 0.0331 * x * x * x * x) return d * v;
	if (Math.log(u) < 0.5 * x * x + d * (1 - v + Math.log(v))) return d * v;
}]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000132</Id>
<Name><![CDATA[dUniforme]]></Name>
<X>1100</X><Y>-240</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[a]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[b]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[return a + (b - a) * uniform();]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000133</Id>
<Name><![CDATA[dTriangular]]></Name>
<X>1100</X><Y>-220</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[a]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[moda]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[b]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[double u = uniform();
double fc = (moda - a) / (b - a);
return u < fc ? a + Math.sqrt(u * (b - a) * (moda - a)) : b - Math.sqrt((1 - u) * (b - a) * (b - moda));]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000134</Id>
<Name><![CDATA[dPert]]></Name>
<X>1100</X><Y>-200</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[a]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[moda]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[b]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[lambda]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[double r = b - a;
double x = gammaStd(1 + lambda * (moda - a) / r), y = gammaStd(1 + lambda * (b - moda) / r);
return a + r * x / (x + y);]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000135</Id>
<Name><![CDATA[dNormal]]></Name>
<X>1100</X><Y>-180</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[media]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[sd]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[return media + sd * nStd();]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000136</Id>
<Name><![CDATA[dLognormal]]></Name>
<X>1100</X><Y>-160</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[media]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[sd]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[if (sd <= 0) return media;
double s2 = Math.log(1 + sd * sd / (media * media));
return Math.exp(Math.log(media) - s2 / 2 + Math.sqrt(s2) * nStd());]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000137</Id>
<Name><![CDATA[dExponencial]]></Name>
<X>1100</X><Y>-140</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[media]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[return -media * Math.log(u01());]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000138</Id>
<Name><![CDATA[dGamma]]></Name>
<X>1100</X><Y>-120</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[media]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[sd]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[if (sd <= 0) return media;
double k = (media / sd) * (media / sd);
return gammaStd(k) * media / k;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000139</Id>
<Name><![CDATA[dErlang]]></Name>
<X>1100</X><Y>-100</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[media]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[k]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[double p = 1;
for (int i = 0; i < k; i++) p *= u01();
return -media / k * Math.log(p);]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000140</Id>
<Name><![CDATA[dWeibull]]></Name>
<X>1100</X><Y>-80</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[forma]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[escala]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[loc]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[return loc + escala * Math.pow(-Math.log(u01()), 1 / forma);]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000141</Id>
<Name><![CDATA[dBeta]]></Name>
<X>1100</X><Y>-60</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[alfa]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[beta]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[min]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[max]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[double x = gammaStd(alfa), y = gammaStd(beta);
return min + (max - min) * x / (x + y);]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
