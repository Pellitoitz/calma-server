<Type><![CDATA[String]]></Type>
</Parameter>
<Body><![CDATA[switch (prod) {
case 0:
	return 1.0;
case 1:
	if (tipo.equals("wiring")) return 1.3;
	if (tipo.equals("inspection")) return 1.2;
	return 1.0;
}
return 1.0;]]></Body>
