<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[// Embalaje y etiquetado (packing)
Operario o = p.operario;
int m = estMaquina[st];
double espera = 0, caminar = 0;
if (o != null) {
	espera = pausaPendiente(o);
	caminar = caminar(o, st);
	recuperar(o);
}
double base = Math.max(0, dLognormal(40.0, 6.0));
if (o != null) base = Math.max(0, 40.0 + (base - 40.0) * opConsistencia[o.idx]);
double f = factorProducto(p.producto, "embalaje", "packing");
if (o != null) {
	f *= 100.0 / ritmo(o.idx, "packing", "embalaje");
	f *= aprendizajeOp(o, "embalaje");
	f *= fatiga(o);
}
double trabajo = base * f;
double viaje = 0;
double interr = interrupciones(1.0, trabajo + viaje, () -> dExponencial(15.0));
double averia = 0;
double total = espera + caminar + trabajo + viaje + interr + averia;
if (o != null) registrarTrabajo(o, "embalaje", total, espera);
return total;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000182</Id>
<Name><![CDATA[op_setup]]></Name>
<X>1280</X><Y>-40</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[p]]></Name>
<Type><![CDATA[Pieza]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[st]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[// Cambio de referencia (setup)
Operario o = p.operario;
int m = estMaquina[st];
double espera = 0, caminar = 0;
if (o != null) {
	espera = pausaPendiente(o);
	caminar = caminar(o, st);
	recuperar(o);
}
double base = Math.max(0, dPert(240.0, 360.0, 720.0, 4.0));
if (o != null) base = Math.max(0, 400.0 + (base - 400.0) * opConsistencia[o.idx]);
double f = factorProducto(p.producto, "setup", "setup");
if (o != null) {
	f *= 100.0 / ritmo(o.idx, "setup", "setup");
	f *= aprendizajeOp(o, "setup");
}
double trabajo = base * f;
double viaje = 0;
double interr = interrupciones(2.0, trabajo + viaje, () -> dExponencial(60.0));
double averia = 0;
double total = espera + caminar + trabajo + viaje + interr + averia;
if (o != null) registrarTrabajo(o, "setup", total, espera);
return total;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000183</Id>
<Name><![CDATA[op_cinta]]></Name>
<X>1280</X><Y>-20</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[p]]></Name>
<Type><![CDATA[Pieza]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[st]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[// Cinta al horno (transport)
Operario o = null;
int m = estMaquina[st];
double espera = 0, caminar = 0;
double base = Math.max(0, 2.0);
double f = factorProducto(p.producto, "cinta", "transport");
double trabajo = base * f;
double viaje = 0;
int destino = Math.min(st + 1, distancia.length - 1);
double v = Math.max(0.05, dUniforme(0.45, 0.55));
viaje = distancia[st][destino] / v;
double interr = 0;
double averia = 0;
double total = espera + caminar + trabajo + viaje + interr + averia;
return total;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000184</Id>
<Name><![CDATA[op_andar]]></Name>
<X>1280</X><Y>0</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[p]]></Name>
<Type><![CDATA[Pieza]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[st]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[// Desplazamiento (walking)
Operario o = p.operario;
int m = estMaquina[st];
double espera = 0, caminar = 0;
if (o != null) {
	espera = pausaPendiente(o);
	caminar = caminar(o, st);
	recuperar(o);
}
double base = Math.max(0, 0.0);
if (o != null) base = Math.max(0, 0.0 + (base - 0.0) * opConsistencia[o.idx]);
double f = factorProducto(p.producto, "andar", "walking");
if (o != null) {
	f *= fatiga(o);
}
double trabajo = base * f;
double viaje = 0;
int destino = Math.min(st + 1, distancia.length - 1);
double v = Math.max(0.05, (o != null ? velocidadMarcha(o.idx) : dTruncar(() -> dNormal(1.2, 0.15), 0.5, 2.0)));
viaje = distancia[st][destino] / v * (o != null ? fatiga(o) : 1);
double interr = 0;
double averia = 0;
double total = espera + caminar + trabajo + viaje + interr + averia;
if (o != null) registrarTrabajo(o, "andar", total, espera);
return total;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000185</Id>
<Name><![CDATA[ritmo]]></Name>
<X>1280</X><Y>20</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[idx]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[tipo]]></Name>
<Type><![CDATA[String]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[opId]]></Name>
<Type><![CDATA[String]]></Type>
</Parameter>
<Body><![CDATA[switch (idx) {
case 0:
	return 100.0;
case 1:
	if (tipo.equals("wiring")) return 115.0;
	return 105.0;
case 2:
	return 95.0;
}
return 100.0;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000186</Id>
<Name><![CDATA[velocidadMarcha]]></Name>
<X>1280</X><Y>40</Y>
