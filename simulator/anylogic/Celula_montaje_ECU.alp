<Name><![CDATA[st]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[// Atornillado de tapa (6 tornillos) (screwing)
Operario o = p.operario;
int m = estMaquina[st];
double espera = 0, caminar = 0;
if (o != null) {
	espera = pausaPendiente(o);
	caminar = caminar(o, st);
	recuperar(o);
}
double base = Math.max(0, dLognormal(35.0, 4.0));
if (o != null) base = Math.max(0, 35.0 + (base - 35.0) * opConsistencia[o.idx]);
double f = factorProducto(p.producto, "atornillado", "screwing");
if (o != null) {
	f *= 100.0 / ritmo(o.idx, "screwing", "atornillado");
	f *= aprendizajeOp(o, "atornillado");
	f *= fatiga(o);
}
double trabajo = base * f;
double viaje = 0;
double interr = interrupciones(3.0, trabajo + viaje, () -> dExponencial(10.0));
double averia = 0;
double total = espera + caminar + trabajo + viaje + interr + averia;
if (o != null) registrarTrabajo(o, "atornillado", total, espera);
return total;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
