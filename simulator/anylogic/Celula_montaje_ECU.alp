<Id>1729000000178</Id>
<Name><![CDATA[op_retrabajo]]></Name>
<X>1280</X><Y>-120</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[p]]></Name>
<Type><![CDATA[Pieza]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[st]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[// Diagnóstico y retrabajo (rework)
Operario o = p.operario;
int m = estMaquina[st];
double espera = 0, caminar = 0;
if (o != null) {
	espera = pausaPendiente(o);
	caminar = caminar(o, st);
	recuperar(o);
}
double base = Math.max(0, dLognormal(150.0, 60.0));
if (o != null) base = Math.max(0, 150.0 + (base - 150.0) * opConsistencia[o.idx]);
double f = factorProducto(p.producto, "retrabajo", "rework");
if (o != null) {
	f *= 100.0 / ritmo(o.idx, "rework", "retrabajo");
	f *= aprendizajeOp(o, "retrabajo");
	f *= fatiga(o);
}
double trabajo = base * f;
double viaje = 0;
double interr = interrupciones(2.0, trabajo + viaje, () -> dExponencial(30.0));
double averia = 0;
double total = espera + caminar + trabajo + viaje + interr + averia;
if (o != null) registrarTrabajo(o, "retrabajo", total, espera);
return total;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
