<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[// Cableado del mazo (wiring)
Operario o = p.operario;
int m = estMaquina[st];
double espera = 0, caminar = 0;
if (o != null) {
	espera = pausaPendiente(o);
	caminar = caminar(o, st);
	recuperar(o);
}
double base = Math.max(0, dLognormal(88.0, 18.0));
if (o != null) base = Math.max(0, 88.0 + (base - 88.0) * opConsistencia[o.idx]);
double f = factorProducto(p.producto, "cableado", "wiring");
if (o != null) {
	f *= 100.0 / ritmo(o.idx, "wiring", "cableado");
	f *= aprendizajeOp(o, "cableado");
	f *= fatiga(o);
}
double trabajo = base * f;
double viaje = 0;
double interr = interrupciones(2.0, trabajo + viaje, () -> dExponencial(25.0));
double averia = 0;
double total = espera + caminar + trabajo + viaje + interr + averia;
if (o != null) registrarTrabajo(o, "cableado", total, espera);
return total;]]></Body>
</Function>
