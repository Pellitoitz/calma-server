<Id>1729000000144</Id>
<Name><![CDATA[dPoisson]]></Name>
<X>1100</X><Y>0</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[lambda]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[if (lambda <= 0) return 0;
if (lambda > 50) return Math.max(0, (int) Math.round(lambda + Math.sqrt(lambda) * nStd()));
double L = Math.exp(-lambda), p = 1;
int k = 0;
do { k++; p *= uniform(); } while (p > L);
return k - 1;]]></Body>
</Function>
