<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[switch (idx) {
case 0: return dTruncar(() -> dNormal(1.2, 0.15), 0.5, 2.0);
case 1: return dTruncar(() -> dNormal(1.2, 0.15), 0.5, 2.0);
case 2: return dTruncar(() -> dNormal(1.2, 0.15), 0.5, 2.0);
}
return 1.2;]]></Body>
</Function>
