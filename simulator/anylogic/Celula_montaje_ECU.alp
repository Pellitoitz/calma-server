<Id>1729000000180</Id>
<Name><![CDATA[op_inspeccion]]></Name>
<X>1280</X><Y>-80</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[p]]></Name>
<Type><![CDATA[Pieza]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[st]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[// Inspección visual final (inspection)
Operario o = p.operario;
int m = estMaquina[st];
double espera = 0, caminar = 0;
if (o != null) {
	espera = pausaPendiente(o);
	caminar = caminar(o, st);
	recuperar(o);
}
double base = Math.max(0, dGamma(25.0, 5.0));
if (o != null) base = Math.max(0, 25.0 + (base - 25.0) * opConsistencia[o.idx]);
double f = factorProducto(p.producto, "inspeccion", "inspection");
if (o != null) {
	f *= 100.0 / ritmo(o.idx, "inspection", "inspeccion");
	f *= aprendizajeOp(o, "inspeccion");
	f *= fatiga(o);
}
double trabajo = base * f;
double viaje = 0;
double interr = interrupciones(1.0, trabajo + viaje, () -> dExponencial(15.0));
double averia = 0;
double total = espera + caminar + trabajo + viaje + interr + averia;
if (o != null) registrarTrabajo(o, "inspeccion", total, espera);
return total;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000181</Id>
<Name><![CDATA[op_embalaje]]></Name>
<X>1280</X><Y>-60</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
