<Name><![CDATA[p]]></Name>
<Type><![CDATA[Pieza]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[st]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[// Remachado automático (machining)
Operario o = null;
int m = estMaquina[st];
double espera = 0, caminar = 0;
double base = Math.max(0, dTruncar(() -> dNormal(22.0, 0.8), 0.0, Double.MAX_VALUE));
if (m >= 0) base = Math.max(0, 22.0011220667 + (base - 22.0011220667) * maqConsistencia[m]);
double f = factorProducto(p.producto, "remachado", "machining");
if (m >= 0) f /= maqVelocidad[m];
double trabajo = base * f;
double viaje = 0;
double interr = 0;
double averia = averias(m, trabajo + viaje + interr);
double total = espera + caminar + trabajo + viaje + interr + averia;
return total;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
