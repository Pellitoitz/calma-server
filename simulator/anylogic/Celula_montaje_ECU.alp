if (o != null) {
	espera = pausaPendiente(o);
	caminar = caminar(o, st);
	recuperar(o);
}
double base = Math.max(0, dLognormal(55.0, 8.0));
if (o != null) base = Math.max(0, 55.0 + (base - 55.0) * opConsistencia[o.idx]);
double f = factorProducto(p.producto, "montaje", "manual_assembly");
if (o != null) {
	f *= 100.0 / ritmo(o.idx, "manual_assembly", "montaje");
