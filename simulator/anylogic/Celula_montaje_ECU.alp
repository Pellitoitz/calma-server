</Parameter>
<Body><![CDATA[if (p.defectuosa && uniform() < eficaciaRetrabajo(opId)) p.defectuosa = false;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[void]]></ReturnType>
<Id>1729000000162</Id>
<Name><![CDATA[registrarSalida]]></Name>
<X>1100</X><Y>360</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[p]]></Name>
<Type><![CDATA[Pieza]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[terminada]]></Name>
<Type><![CDATA[boolean]]></Type>
</Parameter>
<Body><![CDATA[cambiarWip(-1);
if (!enObservacion()) return;
if (terminada) {
	terminadas++;
	leadTimes.add(time() - p.creada);
	if (p.primeraPasada) primeraPasada++;
	if (p.defectuosa) escapados++;
} else desechadas++;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000163</Id>
<Name><![CDATA[percentil]]></Name>
<X>1100</X><Y>380</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[q]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[if (leadTimes.isEmpty()) return 0;
java.util.ArrayList<Double> s = new java.util.ArrayList<Double>(leadTimes);
java.util.Collections.sort(s);
double pos = (s.size() - 1) * q;
int lo = (int) Math.floor(pos), hi = (int) Math.ceil(pos);
return s.get(lo) + (s.get(hi) - s.get(lo)) * (pos - lo);]]></Body>
</Function>
