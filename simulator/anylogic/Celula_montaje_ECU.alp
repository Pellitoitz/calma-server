<Function AccessType="public" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[void]]></ReturnType>
<Id>1729000000147</Id>
<Name><![CDATA[recuperar]]></Name>
<X>1100</X><Y>60</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[o]]></Name>
<Type><![CDATA[Operario]]></Type>
</Parameter>
<Body><![CDATA[double ociosoH = (time() - o.ultimoCambio) / 3600;
if (ociosoH > 0) {
	o.fatigaH *= Math.exp(-ociosoH / opRecuperacionH[o.idx]);
	o.ultimoCambio = time();
}]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000148</Id>
<Name><![CDATA[fatiga]]></Name>
<X>1100</X><Y>80</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[o]]></Name>
<Type><![CDATA[Operario]]></Type>
</Parameter>
<Body><![CDATA[double tau = opFatigaTauH[o.idx] > 0 ? opFatigaTauH[o.idx] : 3;
double f = 1 + opFatigaMax[o.idx] * (1 - Math.exp(-o.fatigaH / tau));
if (f > o.maxFatiga) o.maxFatiga = f;
return f;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000149</Id>
<Name><![CDATA[aprendizaje]]></Name>
<X>1100</X><Y>100</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[o]]></Name>
<Type><![CDATA[Operario]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[opId]]></Name>
<Type><![CDATA[String]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[tasa]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[experiencia]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[estandar]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[meseta]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[if (tasa >= 1 || tasa <= 0) return 1;
int reps = o.repeticiones.getOrDefault(opId, 0);
double b = Math.log(tasa) / Math.log(2);
double nEff = Math.max(1, experiencia + reps + 1);
return Math.max(meseta, Math.pow(nEff / Math.max(1, estandar), b));]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000150</Id>
<Name><![CDATA[interrupciones]]></Name>
<X>1100</X><Y>120</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[porHora]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[trabajo]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[duracion]]></Name>
<Type><![CDATA[DoubleSupplier]]></Type>
</Parameter>
<Body><![CDATA[if (porHora <= 0) return 0;
int n = dPoisson(porHora * trabajo / 3600);
double t = 0;
for (int i = 0; i < n; i++) t += Math.max(0, duracion.getAsDouble());
return t;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000151</Id>
<Name><![CDATA[caminar]]></Name>
<X>1100</X><Y>140</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[o]]></Name>
<Type><![CDATA[Operario]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[st]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[if (o.ubicacion < 0) o.ubicacion = opCasa[o.idx];
double d = distancia[o.ubicacion][st];
o.ubicacion = st;
if (d < 0.05) return 0;
double v = Math.max(0.05, velocidadMarcha(o.idx));
if (enObservacion()) o.metros += d;
return d / v * fatiga(o);]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000152</Id>
<Name><![CDATA[pausaPendiente]]></Name>
<X>1100</X><Y>160</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[o]]></Name>
<Type><![CDATA[Operario]]></Type>
</Parameter>
<Body><![CDATA[// Pausas del turno: si el operario estaba ocupado al empezar la pausa, la hace
// al terminar su tarea (como en el simulador web).
double espera = 0;
double ahora = time();
for (double inicioTurno = 0; inicioTurno <= ahora; inicioTurno += turnoH * 3600) {
	for (int b = 0; b < pausaInicioH.length; b++) {
		double ini = inicioTurno + pausaInicioH[b] * 3600;
		if (ini <= o.ultimaPausa || ini > ahora) continue;
		double comienzo = Math.max(ini, o.finTarea);
		double fin = comienzo + pausaMin[b] * 60;
		espera = Math.max(espera, fin - ahora);
		o.ultimaPausa = ini;
		if (enObservacion()) o.tiempoPausa += pausaMin[b] * 60;
	}
}
return Math.max(0, espera);]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1729000000153</Id>
<Name><![CDATA[averias]]></Name>
<X>1100</X><Y>180</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[m]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[trabajo]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[// Averías según tiempo de marcha (MTBF) y reparación (MTTR)
if (m < 0 || !maqAverias[m]) return 0;
double extra = 0, resto = trabajo;
while (resto > maqUptime[m]) {
	resto -= maqUptime[m];
	double rep = Math.max(1, mttr(m));
	extra += rep;
	if (enObservacion()) { maqFallos[m]++; maqTiempoCaido[m] += rep; }
	maqUptime[m] = Math.max(1, mtbf(m));
}
maqUptime[m] -= resto;
return extra;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[void]]></ReturnType>
<Id>1729000000154</Id>
<Name><![CDATA[registrarTrabajo]]></Name>
<X>1100</X><Y>200</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[o]]></Name>
<Type><![CDATA[Operario]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[opId]]></Name>
<Type><![CDATA[String]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[total]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[espera]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[o.repeticiones.merge(opId, 1, Integer::sum);
o.fatigaH += (total - espera) / 3600;
o.finTarea = time() + total;
o.ultimoCambio = o.finTarea;
if (enObservacion()) { o.ocupado += total - espera; o.tareas++; }]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[void]]></ReturnType>
<Id>1729000000155</Id>
<Name><![CDATA[cambiarWip]]></Name>
<X>1100</X><Y>220</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[delta]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[double desde = Math.max(wipT, calentamientoH * 3600);
if (time() > desde) wipArea += wip * (time() - desde);
wipT = time();
wip += delta;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[void]]></ReturnType>
<Id>1729000000156</Id>
<Name><![CDATA[asignarProducto]]></Name>
<X>1100</X><Y>240</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[p]]></Name>
<Type><![CDATA[Pieza]]></Type>
</Parameter>
<Body><![CDATA[if (loteRestante <= 0) {
	loteProducto = elegirProducto();
	loteRestante = tamanoLote;
}
loteRestante--;
p.producto = loteProducto;
p.creada = time();
if (enObservacion()) creadas++;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[boolean]]></ReturnType>
<Id>1729000000157</Id>
<Name><![CDATA[necesitaSetup]]></Name>
<X>1100</X><Y>260</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[p]]></Name>
<Type><![CDATA[Pieza]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[st]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[boolean necesita = false;
if (setupModo[st] == 1) necesita = ultimoProducto[st] >= 0 && ultimoProducto[st] != p.producto;
else if (setupModo[st] == 2) necesita = setupCadaN[st] > 0 && desdeSetup[st] >= setupCadaN[st];
if (necesita) { desdeSetup[st] = 0; if (enObservacion()) setups++; }
ultimoProducto[st] = p.producto;
desdeSetup[st]++;
return necesita;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[void]]></ReturnType>
<Id>1729000000158</Id>
<Name><![CDATA[trasOperacion]]></Name>
<X>1100</X><Y>280</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[p]]></Name>
<Type><![CDATA[Pieza]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[opId]]></Name>
<Type><![CDATA[String]]></Type>
</Parameter>
<Body><![CDATA[double prob = probDefecto(opId);
if (prob <= 0) return;
if (p.operario != null && opSensCalidad[p.operario.idx] > 0) prob *= 1 + opSensCalidad[p.operario.idx] * (fatiga(p.operario) - 1);
if (uniform() < Math.min(1, prob)) {
	p.defectuosa = true;
	if (enObservacion()) defectosCreados++;
}]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[boolean]]></ReturnType>
<Id>1729000000159</Id>
<Name><![CDATA[inspeccionOk]]></Name>
<X>1100</X><Y>300</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[p]]></Name>
<Type><![CDATA[Pieza]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[opId]]></Name>
<Type><![CDATA[String]]></Type>
</Parameter>
<Body><![CDATA[boolean ok;
if (p.defectuosa) ok = uniform() >= probDeteccion(opId);
else {
	ok = uniform() >= probFalsoRechazo(opId);
	if (!ok && enObservacion()) falsosRechazos++;
}
if (!ok) { p.primeraPasada = false; if (enObservacion()) rechazos++; }
return ok;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[boolean]]></ReturnType>
<Id>1729000000160</Id>
<Name><![CDATA[puedeRetrabajar]]></Name>
<X>1100</X><Y>320</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[p]]></Name>
<Type><![CDATA[Pieza]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[opId]]></Name>
<Type><![CDATA[String]]></Type>
</Parameter>
<Body><![CDATA[if (!retrabajaSiRechaza(opId) || p.retrabajos >= maxRetrabajos(opId)) return false;
p.retrabajos++;
if (enObservacion()) retrabajos++;
return true;]]></Body>
</Function>
<Function AccessType="public" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[void]]></ReturnType>
<Id>1729000000161</Id>
